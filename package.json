{
  "name": "zod2gql",
  "version": "0.0.1",
  "description": "Convert Zod schemas to GraphQL queries.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "clean": "rm -rf ./dist",
    "build": "pnpm clean && tsc",
    "compile": "pnpm build",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "lint:ratchet": "node scripts/lint-ratchet.mjs",
    "lint:ratchet:update": "node scripts/lint-ratchet.mjs --update",
    "format": "prettier --check '**/*.{ts,tsx,js,jsx,json,md,mdx}'",
    "format:fix": "prettier --write '**/*.{ts,tsx,js,jsx,json,md,mdx}'",
    "prettier": "pnpm format",
    "prettier-fix": "pnpm format:fix",
    "fix": "pnpm format:fix && pnpm lint:fix",
    "typecheck": "tsc --noEmit",
    "typecheck:ratchet": "node scripts/typecheck-ratchet.mjs",
    "typecheck:ratchet:update": "node scripts/typecheck-ratchet.mjs --update",
    "ts:coverage": "node scripts/ts-coverage.mjs",
    "ts:ratchet": "node scripts/ts-ratchet.mjs",
    "ts:ratchet:update": "node scripts/ts-ratchet.mjs --update",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 3001",
    "storybook-build": "storybook build",
    "build-storybook": "storybook build",
    "storybook-run": "npx http-server storybook-static -p 3001",
    "storybook-deploy": "storybook build && gh-pages -d storybook-static",
    "storybook-test": "test-storybook --url http://localhost:3001 --browsers chromium,firefox,webkit",
    "test:storybook:integration": "sh ./scripts/run-storybook-playwright-tests.sh",
    "check": "pnpm format && pnpm lint && pnpm typecheck && pnpm test",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JamesonRGrieve/zod2gql.git"
  },
  "keywords": [
    "zod",
    "typescript",
    "typesafe",
    "gql",
    "graphql"
  ],
  "author": "Jameson R Grieve",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/JamesonRGrieve/zod2gql/issues"
  },
  "homepage": "http://jamesonrgrieve.github.io/zod2gql",
  "files": [
    "dist"
  ],
  "_moduleAliases": {
    "@": "."
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx}": [
      "eslint --fix --quiet",
      "prettier --write"
    ],
    "**/*.{json,md,mdx}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "next": "^15.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.34.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@babel/plugin-transform-runtime": "^7.27.4",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@playwright/test": "^1.55.1",
    "@storybook/addon-actions": "^8.6.14",
    "@storybook/addon-docs": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/nextjs": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@storybook/test-runner": "^0.22.1",
    "@types/node": "^22.13.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@vitest/coverage-v8": "^2.1.9",
    "@vitest/ui": "^2.1.9",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-storybook": "^0.12.0",
    "gh-pages": "^6.3.0",
    "happy-dom": "^15.11.7",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "playwright": "^1.55.1",
    "prettier": "^3.5.3",
    "storybook": "^8.6.14",
    "typescript": "^5.9.2",
    "vitest": "^2.1.9"
  }
}
