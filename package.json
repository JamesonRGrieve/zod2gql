{
  "name": "zod2gql",
  "version": "0.0.1",
  "description": "Convert Zod schemas to GraphQL queries.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint-fix": "npm run lint:fix",
    "lint:ratchet": "node scripts/lint-ratchet.mjs",
    "lint:ratchet:update": "node scripts/lint-ratchet.mjs --update",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prettier": "npm run format",
    "prettier-fix": "npm run format:fix",
    "fix": "npm run format:fix && npm run lint:fix",
    "typecheck": "tsc --noEmit",
    "typecheck:ratchet": "node scripts/typecheck-ratchet.mjs",
    "typecheck:ratchet:update": "node scripts/typecheck-ratchet.mjs --update",
    "symmetry": "node scripts/coverage-symmetry.mjs",
    "symmetry:ratchet": "node scripts/symmetry-ratchet.mjs",
    "symmetry:ratchet:update": "node scripts/symmetry-ratchet.mjs --update",
    "js-coverage": "node scripts/js-coverage.mjs",
    "js-coverage:ratchet": "node scripts/js-coverage-ratchet.mjs",
    "js-coverage:ratchet:update": "node scripts/js-coverage-ratchet.mjs --update",
    "compile": "rm -rf ./dist && tsc -p tsconfig.compile.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint:ratchet && npm run format && npm run typecheck:ratchet && npm run symmetry:ratchet && npm run js-coverage:ratchet && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JamesonRGrieve/zod2gql.git"
  },
  "keywords": [
    "zod",
    "typescript",
    "typesafe",
    "gql",
    "graphql"
  ],
  "author": "Jameson R Grieve",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/JamesonRGrieve/zod2gql/issues"
  },
  "homepage": "http://jamesonrgrieve.github.io/zod2gql",
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "zod": "^3.24.2"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^15.15.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
